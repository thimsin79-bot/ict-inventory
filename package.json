{
  "name": "ict-inventory",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env lib/db/seed.ts",
    "db:reset": "tsx --env-file=.env lib/db/seed.ts --reset"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
