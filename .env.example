# Copy to .env and fill in your own values.
# .env is gitignored and must never be committed.
# Next.js and drizzle-kit both read this file automatically.

# PostgreSQL connection string.
# URL-encode any special characters in the password:
#   @ -> %40    " -> %22    # -> %23    : -> %3A    / -> %2F
DATABASE_URL=postgresql://postgres:your-password@localhost:5432/ict_inventory

# Random hex string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Redis pub/sub lets live updates (SSE) propagate across multiple app
# instances. Leave unset for single-instance / local development, where the
# in-process event bus is used instead.
# REDIS_URL=redis://localhost:6379
